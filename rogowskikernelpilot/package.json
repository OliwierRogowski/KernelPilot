{
  "name": "rogowskikernelpilot",
  "displayName": "KernelPilot",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "KernelPilot",
      "properties": {
        "kernelpilot.analyzerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the KernelPilot native analyzer executable. Leave empty to use native-analyzer/build/kernelpilot-analyzer in the extension folder."
        },
        "kernelpilot.benchmarkCompiler": {
          "type": "string",
          "default": "",
          "description": "Compiler executable for native benchmarks. Leave empty to use gcc for C and g++ for C++."
        },
        "kernelpilot.cudaCompiler": {
          "type": "string",
          "default": "nvcc",
          "description": "CUDA compiler executable used to compile AI-generated CPU/GPU comparison programs."
        },
        "kernelpilot.cpuCompiler": {
          "type": "string",
          "default": "g++",
          "description": "C++ compiler used to syntax-check AI-generated CPU conversions."
        },
        "kernelpilot.chatModel": {
          "type": "string",
          "default": "llama4:maverick",
          "description": "Ollama model used for the KernelPilot chat panel."
        },
        "kernelpilot.codingModel": {
          "type": "string",
          "default": "llama4:maverick",
          "description": "Ollama code model used to generate benchmark harnesses, CUDA implementations, and performance recommendations."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kernelpilot",
          "title": "KernelPilot",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "kernelpilot":[
        {
          "type": "webview",
          "id": "kernelpilot.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "rogowskikernelpilot.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "rogowskikernelpilot.explainSelection",
        "title": "KernelPilot: Explain selected code"
      },
      {
        "command": "rogowskikernelpilot.analyzeFile",
        "title": "KernelPilot: Analyze current C/C++ file"
      },
      {
        "command": "rogowskikernelpilot.analyzeWithAI",
        "title": "KernelPilot: Review code with local AI"
      },
      {
        "command": "rogowskikernelpilot.benchmark",
        "title": "KernelPilot: Benchmark file or selection"
      },
      {
        "command": "rogowskikernelpilot.convertCuda",
        "title": "KernelPilot: Convert file or selection to CUDA"
      },
      {
        "command": "rogowskikernelpilot.convertCpu",
        "title": "KernelPilot: Convert CUDA file or selection to CPU"
      },
      {
        "command": "rogowskikernelpilot.cudaHelp",
        "title": "KernelPilot: CUDA programming help"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
