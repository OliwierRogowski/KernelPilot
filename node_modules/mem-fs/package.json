  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tsc": "tsc"
  },
  "dependencies": {
    "vinyl": "^3.0.1",
    "vinyl-file": "^5.0.0"
  },
  "peerDependencies": {
    "@types/node": ">=18",
    "@types/vinyl": "^2.0.12"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "@types/vinyl": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "gitHead": "f47dad3b915d9e0e62b29551b2098c9dbf2e5f4b"
