# Optional OpenAI-compatible provider example. Copy to .env and enter your own credential.
# Confirm the selected provider accepts this endpoint, model, and chat-completions protocol.
KERNELPILOT_AI_PROVIDER=openai-compatible
KERNELPILOT_AI_BASE_URL=https://api.meta.ai/v1
KERNELPILOT_AI_API_KEY=your-api-key-here
KERNELPILOT_AI_MODEL=muse-spark-1.3
KERNELPILOT_AI_TIMEOUT=120000
KERNELPILOT_AI_TEMPERATURE=0.1
KERNELPILOT_AI_MAX_TOKENS=8192
