{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run KernelPilot Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/rogowskikernelpilot"
            ],
            "outFiles": [
                "${workspaceFolder}/rogowskikernelpilot/dist/**/*.js"
            ],
            "preLaunchTask": "KernelPilot: compile extension"
        }
    ]
}